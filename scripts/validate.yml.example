# Optional GitHub Actions example. Copy to .github/workflows/validate.yml
# only when your GitHub authentication permits publishing workflow files.
name: Validate runnable task
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  validate:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
      - name: Unit checks and deterministic package
        run: |
          python3 -m unittest discover -s tests -p 'test_*.py'
          python3 scripts/package_environment.py
          git diff --exit-code -- environment/task-source.tar.gz environment/source-manifest.json tests/gamebench tests/assets-manifest.json
          cmp requirements.txt environment/requirements.txt
      - name: Build standard environment context
        run: docker build -t openrsi-game:ci environment/
      - name: Full offline Judge evaluation
        run: |
          mkdir -p runs
          docker run --rm --network none --cpus 4 --memory 8g \
            -v "$PWD/tests:/tests:ro" -v "$PWD/runs:/logs/verifier" \
            openrsi-game:ci bash /tests/test.sh
          python3 -c "import json; d=json.load(open('runs/result.json')); assert d['official_full_run'] and d['cases']==96 and d['eligible_judgments']==160 and d['score']==0.875"
